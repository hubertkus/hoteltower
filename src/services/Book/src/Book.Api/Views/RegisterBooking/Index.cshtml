@using Booking.Models.ViewModels
@model RegisterBookingViewModel

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="~/_content/Shared.UI/css/site.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <title>Rezerwacja w hotelu Tower</title>
</head>

<body>
    <div>
        <h2>Witamy w Hotelu Tower</h2>
    </div>

    <div class="container">
        <h1>Rezerwacja</h1>

        <form asp-controller="RegisterBooking" asp-action="Index" method="post">
            <input asp-for="UserId" type="hidden" />

            <div class="form-group">
                <label asp-for="RoomId" style="color: #1976d2;">Nr. pokoju</label>
                <select asp-for="RoomId">
                    <option value="">Wybierz pokój</option>
                    @foreach (var room in Model.Rooms)
                    {
                        <option value="@room.Value">@room.Text</option>
                    }
                </select>
                <span asp-validation-for="RoomId" class="validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="From" style="color: #1976d2;">Data rozpoczęcia</label>
                <input asp-for="From" type="text" class="form-control datepicker" />
                <span asp-validation-for="From" class="validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="To" style="color: #1976d2;">Data zakończenia</label>
                <input asp-for="To" type="text" class="form-control datepicker" />
                <span asp-validation-for="To" class="validation"></span>
            </div>

            <button type="submit" class="button">Zarezerwuj</button>

        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/pl.js"></script>

    <script>
        flatpickr(".datepicker", {
        locale: "pl",
        dateFormat: "Y-m-d",
        altInput: true,
        altFormat: "d.m.Y",
        minDate: "today",
        disableMobile: true
        });
    </script>
</body>
</html>
