@using User.Models.ViewModels
@model RegisterUserViewModel

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="~/_content/Shared.UI/css/site.css"/>
    <title>Witamy w hotelu Tower</title>
</head>

<body>

    <div>
        <h2>Witamy w Hotelu Tower</h2>
    </div>

    <div class="container">

        <h1>Rejestracja</h1>

        <form asp-controller="RegisterUser" asp-action="Index" method="post">

            <div class="form-group">
                <label asp-for="Name">Nazwa użytkownika</label>
                <input asp-for="Name" />
                <span asp-validation-for="Name" class="validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" />
                <span asp-validation-for="Email" class="validation"></span>
            </div>

            <button type="submit" class="button">
                Zarejestruj
            </button>

        </form>

    </div>

</body>
</html>